{
  "name": "claude-task-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "从飞书多维表格导入任务，由 Claude Code 串行执行与测试的本地看板",
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/express": "4.17.21",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
